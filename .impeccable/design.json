g class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg><svg class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg><svg class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg><svg class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg></span><span class=\"ds-tot\">~150 min</span></div><div class=\"ds-row\"><span class=\"ds-l\">Automated</span><span class=\"ds-ic ds-red\"><svg class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg><span class=\"ds-half\"><svg class=\"ds-pg\" viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"24\" r=\"22\"/><path fill=\"#fff\" d=\"M22 9h4v17h-4zM22 22h13v4H22z\"/></svg></span></span><span class=\"ds-tot ds-hi\">~15 min</span></div><figcaption class=\"ds-key\">Each clock is 10 minutes of admin.</figcaption></figure>",
